# Reference for all sdk.properties keys read by PropertyFileSettingsLoader.
# Copy to sdk.properties and set auth credentials; uncomment optional keys as needed.
# Duration format: days:hours:minutes:seconds[.millis]  (e.g. 00:00:00:20 = 20 seconds)
# Rate limiters: quoted "limit;duration" pairs, space-separated
# Log levels: off | error | warn | info | debug | trace | all

# --- Authentication (Auth0 JWT; preferred) ---
# Mandatory for token auth unless legacy login is used.
sdk.livescout.auth0.domain=https://auth.sportradar.com/
# Default audience: livedata-feed (prod) or livedata-replay when sdk.livescout.test=true
#sdk.livescout.auth0.audience=livedata-feed
sdk.livescout.auth0.client_id=xxx
sdk.livescout.auth0.kid=xxx
sdk.livescout.auth0.private_key=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- Authentication (legacy; deprecated) ---
# Used only when Auth0 client_id/kid/private_key are missing.
#sdk.livescout.username=xxx
#sdk.livescout.password=xxx

# --- Connection ---
# Default: false (livedata.betradar.com:2017). true uses replay.livedata.betradar.com:2047
#sdk.livescout.test=false
# Default host/port depend on sdk.livescout.test (see LiveScoutSettings.builder)
#sdk.livescout.host_name=livedata.betradar.com
#sdk.livescout.port=2017
# Default: true
#sdk.livescout.use_ssl=true

# --- Reconnect and keep-alive ---
# Default initial_reconnect_wait: 00:00:00:10
#sdk.livescout.initial_reconnect_wait=00:00:00:10
# Default reconnect_wait: 00:00:00:20
#sdk.livescout.reconnect_wait=00:00:00:20
# Default client_alive_msg_timeout: 00:00:00:20
#sdk.livescout.client_alive_msg_timeout=00:00:00:20
# Default server_alive_msg_timeout: 00:00:00:08
#sdk.livescout.server_alive_msg_timeout=00:00:00:08

# --- Buffers and message limits ---
# Default receive_buffer_size: 1048576 (1 MiB)
#sdk.livescout.receive_buffer_size=1048576
# Default max_message_size: 20971520 (20 MiB)
#sdk.livescout.max_message_size=20971520
# Default max_request_match_ids: 100
#sdk.livescout.max_request_match_ids=100
# Default max_request_time_allowance: 00:00:15:00 (15 minutes)
#sdk.livescout.max_request_time_allowance=00:00:15:00
# Default match_expire_max_age: 00:08:00:00 (8 hours)
#sdk.livescout.match_expire_max_age=00:08:00:00

# --- Rate limiters ---
# Default request_limiters: "450;00:00:02:00"
#sdk.livescout.request_limiters="450;00:00:02:00"

# --- Dispatcher (LMAX Disruptor) ---
# Default dispatcher_thread_count: 4
#sdk.livescout.dispatcher_thread_count=4
# Default dispatcher_queue_size: 16384
#sdk.livescout.dispatcher_queue_size=16384

# --- Behaviour ---
# Default: false
#sdk.livescout.disconnect_on_parse_error=false
# Default: false (enables extra gateway diagnostics when true)
#sdk.livescout.debug=false

# --- LiveScout file logger (sdk.livescout.logger.*) ---
# Default log_path: logs/livescout/
#sdk.livescout.logger.log_path=logs/livescout/
# Default max_file_size: 10485760 (10 MiB)
#sdk.livescout.logger.max_file_size=10485760
# Default old_log_cleanup_interval: 00:01:00:00 (1 hour)
#sdk.livescout.logger.old_log_cleanup_interval=00:01:00:00
# Default old_log_max_age: 00:07:00:00:00 (7 days)
#sdk.livescout.logger.old_log_max_age=00:07:00:00:00
# Default alert_log_level: warn
#sdk.livescout.logger.alert_log_level=warn
# Default client_interaction_log_level: info
#sdk.livescout.logger.client_interaction_log_level=info
# Default invalid_msg_log_level: info
#sdk.livescout.logger.invalid_msg_log_level=info
# Default traffic_log_level: info
#sdk.livescout.logger.traffic_log_level=info

# --- Common execution logger ---
# Default execution_log_level: info
#sdk.common.logger.execution_log_level=info

# --- JMX (sdk-loginterceptor debugging) ---
# Default enabled: false
#sdk.com.sportradar.livedata.sdk.loginterceptor.jmx.enabled=false
# Default host: localhost
#sdk.com.sportradar.livedata.sdk.loginterceptor.jmx.host=localhost
# Default port: 13370
#sdk.com.sportradar.livedata.sdk.loginterceptor.jmx.port=13370
#sdk.com.sportradar.livedata.sdk.loginterceptor.jmx.passwordfile=/path/to/jmxremote.password
#sdk.com.sportradar.livedata.sdk.loginterceptor.jmx.accessfile=/path/to/jmxremote.access
